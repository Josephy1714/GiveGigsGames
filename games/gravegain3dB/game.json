            "C": "Slide while sprinting; crouch when held without sprint",
            "Ctrl": "Crouch",
            "B": "Block (defend / wait in turn-based mode)",
            "Space": "Jump (wait one turn in turn-based mode; hold to glide as Human; tap again midair to double-jump as Dwarf)",
            "F": "Use class ability",
            "Q": "Drink healing potion",
            "Escape / P": "Pause Game"
        },
        "touch": true,
        "mouse": true
