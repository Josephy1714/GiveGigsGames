            "T": "Toggle M4 full-auto / semi-auto",
            "Y": "Fire the M4 underbarrel grenade launcher; R reloads launcher ammo too",
            "G": "Throw grenade (3 to start; loot replenishes, cap 5)",
            "V": "Class attack",
            "N / Middle Mouse": "Weapon bash (short-range strike with the equipped weapon)",
